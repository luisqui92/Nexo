# Copiá a deploy/.env en el servidor. Docker Compose carga este archivo.
NEXO_DOMAIN=app.chatgo.ia.bo
# Correo real para avisos de certificados HTTPS; sin comillas.
ACME_EMAIL=
# La clave de OpenAI se configura dentro del panel central, después de iniciar sesión.
# Opcional: proveedor de teselas para mapas. Dejar vacío usa OpenStreetMap.
NEXO_MAP_TILE_URL=
NEXO_MAP_PROVIDER=OpenStreetMap
