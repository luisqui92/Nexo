# Optional variables. Set in the real environment; Python does not load .env files.
# Core application requires no keys.
HOST=127.0.0.1
PORT=8080
ADVISOR_NAME=Equipo Nexo
NEXO_TIMEZONE=America/La_Paz
# Set a strong password before binding to an external network.
APP_PASSWORD=
# Persistent directory, defaults to ./data
NEXO_DATA_DIR=
# Clinical providers are not reused; provision credentials for this application.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ASSEMBLYAI_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
VAPI_SERVER_SECRET=
GOOGLE_CALENDAR_TOKEN=
GOOGLE_CALENDAR_ID=
BOOKING_START_HOUR=9
BOOKING_END_HOUR=18

# Solo si se sirve a través de HTTPS (proxy): cookie de sesión Secure
# NEXO_HTTPS=1

# Transcripción de audio con OpenAI (modelos económicos sin separación de hablantes)
# NEXO_TRANSCRIPTION_PROVIDER=openai
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Mapas públicos: proveedor de teselas opcional; no usar claves privadas.
# NEXO_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXO_MAP_PROVIDER=OpenStreetMap
